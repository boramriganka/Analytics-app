# All variables are OPTIONAL for local development — sensible defaults apply.

# API
PORT=4000                      # HTTP port for @signalroom/api
JWT_SECRET=                    # REQUIRED in production; dev falls back to a labeled dev-only secret
DB_PATH=                       # SQLite file path (default: apps/api/data/signalroom.db)

# Seeding
SEED_SIZE=25k                  # demo dataset size: 1k | 25k | 250k
